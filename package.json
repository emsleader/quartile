{
  "name": "q1-engine-mcp",
  "version": "0.16.2",
  "description": "MCP server for the Q1 Engine: deterministic academic-manuscript checks (hallucination guard, desk-rejection screen, statistics recomputation, references, Q1 style rules, journal bank) for Claude, ChatGPT and any MCP client.",
  "type": "module",
  "main": "mcp/server.js",
  "bin": {
    "q1-engine-mcp": "mcp/server.js"
  },
  "scripts": {
    "start": "node mcp/server.js",
    "http": "node mcp/server.js --http",
    "test": "node tests/run.js && node tests/rules/run.js && node tests/bugs/run.js",
    "lint": "node scripts/lint.js",
    "test:rules": "node tests/rules/run.js",
    "test:bugs": "node tests/bugs/run.js",
    "test:stats": "node tests/validation/run.js",
    "test:gold": "node tests/gold/run.js",
    "check:changelog": "node scripts/check-changelog.js",
    "check:licences": "node scripts/third-party.js --check"
  },
  "engines": {
    "node": ">=20.10"
  },
  "license": "MIT",
  "author": "Seyed Mehdi Alavi (EMS International Kft)",
  "dependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@citation-js/plugin-doi": "0.9.0",
    "@citation-js/plugin-ris": "0.9.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "diff": "9.0.0",
    "docx": "9.16.0",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "fast-xml-parser": "5.12.1",
    "franc": "6.2.0",
    "fuse.js": "7.5.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "3.11.174",
    "retext": "9.0.0",
    "retext-english": "5.0.0",
    "retext-passive": "5.0.0",
    "retext-readability": "8.0.0",
    "retext-simplify": "8.0.0",
    "sql.js": "1.17.0",
    "ulid": "3.0.2",
    "write-good": "1.0.8",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
